# ========================================
# DataLens AI — Production Environment
# ========================================
# Copy to .env and fill in all required values.
#   cp .env.production.example .env
#
# Then deploy with:
#   docker compose -f docker-compose.prod.yaml up -d

# ─── Required ───────────────────────────────────────────────────────
# Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL credentials (these create the initial database user)
DB_USER=datalens
DB_PASSWORD=replace_with_strong_random_password

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32

# ─── LLM ────────────────────────────────────────────────────────────
# Model to use (default: qwen/qwen3-32b)
MODEL_NAME=qwen/qwen3-32b

# ─── Frontend URLs ──────────────────────────────────────────────────
# Public-facing URL of the frontend (used by browser clients)
# For Cloudflare Pages, set these in the Pages dashboard (not in .env)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slash)
# Include your Cloudflare Pages domain + any custom domain
CORS_ORIGINS=https://yourdomain.com,https://*.yourdomain.pages.dev,https://api.yourdomain.com

# ─── Database (Supabase PostgreSQL) ────────────────────────────────
# Full DATABASE_URL (overrides individual params below).
# Supabase requires sslmode=require for asyncpg.
# URL-encode special chars in the password (* → %2A, @ → %40, etc.)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
#
# Individual connection params (fallback if DATABASE_URL is empty)
# DB_HOST=db.xxxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=postgres

# ─── Redis ──────────────────────────────────────────────────────────
# Option A: Upstash Redis (recommended)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
#
# Option B: Standard Redis
# REDIS_URL=redis://:password@your-redis-host:6379/0

# ─── R2 / S3-compatible Storage ────────────────────────────────────
# Cloudflare R2 — optional but recommended for DataFrame persistence
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=datalens
# Note: R2 bucket must already exist (boto3 does not auto-create)

# ─── Application ────────────────────────────────────────────────────
ENVIRONMENT=production
MAX_UPLOAD_MB=100
SESSION_TTL_SECONDS=3600
LOG_LEVEL=INFO
JWT_EXPIRE_MINUTES=1440
