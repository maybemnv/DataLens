# ========================================
# DataLens AI — Production Environment
# ========================================
# Copy to .env and fill in all required values.
#   cp .env.production.example .env
#
# Then deploy with:
#   docker compose -f docker-compose.prod.yaml up -d

# ─── Required ───────────────────────────────────────────────────────
# Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL credentials (these create the initial database user)
DB_USER=datalens
DB_PASSWORD=replace_with_strong_random_password

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32

# ─── LLM ────────────────────────────────────────────────────────────
# Model to use (default: qwen/qwen3-32b)
MODEL_NAME=qwen/qwen3-32b

# ─── Frontend URLs ──────────────────────────────────────────────────
# Public-facing URL of the frontend (used by browser clients)
NEXT_PUBLIC_API_URL=https://api.datalens.example.com
NEXT_PUBLIC_WS_URL=wss://api.datalens.example.com

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=https://datalens.example.com,https://api.datalens.example.com

# ─── Database ───────────────────────────────────────────────────────
# These are only needed if NOT using the bundled PostgreSQL in docker-compose
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=datalens

# ─── Redis ──────────────────────────────────────────────────────────
# For Upstash (cloud):
# UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
#
# For bundled Redis in docker-compose:
# REDIS_URL=redis://:password@redis:6379/0
# REDIS_PASSWORD=replace_with_redis_password

# ─── Application ────────────────────────────────────────────────────
# Environment: development, staging, or production
ENVIRONMENT=production

# Maximum upload file size in MB (default: 100)
MAX_UPLOAD_MB=100

# Session TTL in seconds (default: 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JWT token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ─── AWS / MinIO (for file storage) ────────────────────────────────
# Only needed if using S3-compatible storage
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=datalens
